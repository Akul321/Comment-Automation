# ---- Safety -------------------------------------------------------------
# Nothing is ever posted while this is true. Change it only after you have
# reviewed a few dozen drafts with: npm run draft
DRY_RUN=true

# LinkedIn detects headless browsers more readily. Keep false unless testing.
HEADLESS=false

# ---- Pacing -------------------------------------------------------------
MAX_COMMENTS_PER_DAY=8
MAX_COMMENTS_PER_RUN=2
MIN_MINUTES_BETWEEN_COMMENTS=25
POLL_MINUTES=30
ACTIVE_HOUR_START=9
ACTIVE_HOUR_END=21
SKIP_WEEKENDS=false

# ---- Post filtering -----------------------------------------------------
MAX_POST_AGE_MINUTES=1440
MIN_POST_CHARS=120
SKIP_REPOSTS=true

# ---- LLM ----------------------------------------------------------------
# groq | gemini | ollama | template
LLM_PROVIDER=groq

# Groq free tier: console.groq.com/keys
#
# Paste your key below, or leave blank and paste it in the dashboard.
# Copy this file to .env — .env is gitignored so the key never gets committed.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Gemini free tier: aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Fully local, no key, no quota: ollama.com
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# ---- Comment shape ------------------------------------------------------
COMMENT_MIN_CHARS=20
COMMENT_MAX_CHARS=150
COMMENT_MIN_WORDS=5
COMMENT_MAX_WORDS=22
